<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="insert-data-into-product_images-table" author="Anton Ivanov">
        <preConditions onFail="CONTINUE" onFailMessage="Table product_images already exists or table is not empty">
            <tableExists tableName="product_images"/>
            <tableIsEmpty tableName="product_images"/>
        </preConditions>

        <loadData
                tableName="product_images"
                file="data/product_images-table-data.csv"
                relativeToChangelogFile="true"
                separator=","
                encoding="UTF-8">

            <column name="product_id" type="uuid"/>
            <column name="url" type="varchar"/>
        </loadData>

        <rollback>
            <sql>
                truncate table product_images
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>